---
import Base from "../layouts/Base.astro";
---

<Base noindex title="Page not found" description="This Nayki page does not exist. Return to the Nayki home page, the docs or the contribute page.">
  <section class="sec forest phead">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>No route here.</h1>
      <p class="lede">That page does not exist. Nothing was submitted or stored.</p>
      <div class="btns">
        <a class="btn" href="/">Back home</a>
        <a class="btn btn--ghost" href="/docs">Docs</a>
      </div>
    </div>
  </section>
</Base>
